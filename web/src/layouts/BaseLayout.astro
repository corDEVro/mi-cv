---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'CV | Juan Manuel Cordero Ganfornina',
	description = 'Currículum de Juan Manuel Cordero Ganfornina — Desarrollador Backend Junior.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen">
		<slot />
	</body>
</html>
