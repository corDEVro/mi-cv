---
interface Props {
	command: string;
	title: string;
	children?: any;
}

const { command, title } = Astro.props;
---

<h2 class="section-title mb-6 text-ink">
	<span class="prompt">$</span>
	<span class="text-muted">{command}</span>
	<span class="text-yellow">{title}</span>
	<span class="cursor"></span>
</h2>
